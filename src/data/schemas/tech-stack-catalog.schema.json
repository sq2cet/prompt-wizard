{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sq2cet/prompt-wizard/schemas/tech-stack-catalog.schema.json",
  "title": "Tech-stack catalog",
  "description": "Recommended stacks per form factor with pros/cons.",
  "type": "object",
  "required": ["version", "form_factors"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "form_factors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/form_factor" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "form_factor": {
      "type": "object",
      "required": ["label", "stacks"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "sub_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "stacks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stack" }
        }
      },
      "additionalProperties": false
    },
    "stack": {
      "type": "object",
      "required": ["name", "pros", "cons"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "sub_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pros": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "cons": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "default_for": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Phrases describing project profiles for which this stack is the recommended default."
        },
        "prerequisites": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tool IDs (matching prerequisite-catalog.yaml) required by this stack."
        }
      },
      "additionalProperties": false
    }
  }
}
