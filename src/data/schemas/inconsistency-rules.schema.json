{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sq2cet/prompt-wizard/schemas/inconsistency-rules.schema.json",
  "title": "Inconsistency rules",
  "description": "Deterministic rules surfaced by the pre-generation review when answers conflict. Rule-based, not AI-driven.",
  "type": "object",
  "required": ["version", "rules"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "rules": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "severity", "when", "message"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "conflict"]
        },
        "when": {
          "type": "object",
          "description": "Match expression. Each key is a JSONPath-like reference into answers; value is an expected literal or a structured operator object.",
          "minProperties": 1,
          "additionalProperties": true
        },
        "message": { "type": "string", "minLength": 1 },
        "suggested_fix": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
